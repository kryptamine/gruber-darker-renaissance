# Generated by `make extras` from palette.lua. Do not edit by hand.

# A delta feature: include this file and set `features = gruber-darker-renaissance`.
# The ansi syntax theme takes its colors from the terminal, so pair it with a
# terminal extra.
[delta "gruber-darker-renaissance"]
	syntax-theme = ansi
	minus-style = syntax "#2a1516"
	minus-emph-style = "#ebebe6" "#732727"
	plus-style = syntax "#1b2e12"
	plus-emph-style = "#ebebe6" "#476834"
	commit-style = "#efd45b"
	file-style = "#efd45b"
	file-decoration-style = "#3a3a3a" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#9e95c7"
	hunk-header-line-number-style = "#9e95c7"
	hunk-header-decoration-style = omit
	whitespace-error-style = "#d64c4b" reverse
	blame-palette = "#000000" "#101010" "#181818" "#1e1e1e"
	merge-conflict-ours-diff-header-style = "#efd45b"
	merge-conflict-theirs-diff-header-style = "#efd45b"
