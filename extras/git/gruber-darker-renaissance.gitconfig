# Generated by `make extras` from palette.lua. Do not edit by hand.

# diff-so-fancy reads diff-highlight too
[color "diff"]
	meta = "#efd45b"
	frag = "#9e95c7"
	func = "#8c8c8c"
	commit = "#efd45b"
	old = "#d64c4b"
	new = "#8ac568"
	whitespace = "#d64c4b" reverse
[color "diff-highlight"]
	oldNormal = "#d64c4b"
	oldHighlight = "#f26063" "#2a1516"
	newNormal = "#8ac568"
	newHighlight = "#8ac568" "#1b2e12"
[color "status"]
	added = "#8ac568"
	changed = "#d64c4b"
	untracked = "#cc8c3c"
	branch = "#efd45b"
